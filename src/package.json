{
  "name": "javascript-test-executor",
  "version": "1.0.0",
  "description": "Sandboxed JavaScript/TypeScript test execution service for code_graph_helper",
  "main": "js_test_service_advanced.js",
  "scripts": {
    "start": "node js_test_service_advanced.js",
    "test": "jest --config ../jest.config.cjs --coverage --verbose"
  },
  "keywords": [
    "testing",
    "javascript",
    "typescript",
    "jest",
    "mocha",
    "chai",
    "compilation",
    "type-checking"
  ],
  "author": "Code Graph Helper",
  "license": "Apache-2.0",
  "dependencies": {
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^10.14.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "redis": "^5.11.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@types/chai": "^5.2.3",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.4.0",
    "babel-jest": "^30.3.0",
    "chai": "^6.3.0",
    "mocha": "^12.0.3",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1",
    "glob": "^10.4.0",
    "mkdirp": "^3.0.1",
    "inflight": "npm:@npmcli/fs@^3.1.0",
    "serialize-javascript": "^7.1.4"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "capabilities": {
    "typescript_compilation": true,
    "type_checking": true,
    "multiple_frameworks": true,
    "es6_modules": true,
    "custom_assertions": true,
    "test_lifecycle_hooks": true
  }
}
